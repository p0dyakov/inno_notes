#!/bin/sh
# Fast gate: new/changed .qmd must pass fix_formatting before push.
# Full per-file bake: python scripts/agent/prebake.py (Windows/dev).
# Bypass (not recommended): SKIP_PREBAKE=1 git push
[ -n "$SKIP_PREBAKE" ] && exit 0
if command -v python3 >/dev/null 2>&1; then PY=python3; else PY=python; fi
exec "$PY" scripts/agent/prebake.py --format-only
